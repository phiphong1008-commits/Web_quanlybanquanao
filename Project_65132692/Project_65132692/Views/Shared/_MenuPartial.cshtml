@model IEnumerable<Project_65132692.Models.LoaiSanPham>

<style>
    .navbar-brand {
        font-weight: bold;
        font-size: 1.5rem;
        color: #333 !important;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
</style>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <div class="container">
        <a class="navbar-brand" href="@Url.Action("Index", "Shop_65132692")">
            <i class="fa-solid fa-moon"></i> NOCTURNAL
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-4 mb-2 mb-lg-0">
                @foreach (var item in Model)
                {
                    <li class="nav-item">
                        <a class="nav-link text-uppercase fw-bold text-secondary mx-2"
                           href="@Url.Action("Index", "LoaiSanPham_65132692", new { maLoai = item.MaLoai })">
                            @item.TenLoai
                        </a>
                    </li>
                }
            </ul>

            <div class="d-flex align-items-center ms-auto">
                <a href="@Url.Action("Index", "GioHang_65132692")" class="btn btn-outline-dark me-2 position-relative">
                    <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        0
                    </span>
                </a>

                @if (Session["KhachHang"] != null)
                {
                    var kh = (Project_65132692.Models.KhachHang)Session["KhachHang"];
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-user"></i> @kh.HoTen
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@Url.Action("LichSuDonHang","UserAuth_65132692")">Lịch sử đơn hàng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="@Url.Action("Logout", "UserAuth_65132692")">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "UserAuth_65132692")" class="btn btn-primary">
                        <i class="fa-solid fa-user"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>
    </div>
</nav>