@model IEnumerable<Project_65132692.Models.SanPham>

@{
    ViewBag.Title = "Quản lý Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-primary m-0 fw-bold"><i class="fa-solid fa-shirt"></i> QUẢN LÝ SẢN PHẨM</h3>
    <a href="@Url.Action("Create")" class="btn btn-success shadow-sm fw-bold">
        <i class="fa-solid fa-plus"></i> Thêm sản phẩm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="bg-primary text-white text-center text-uppercase small fw-bold">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Phân loại</th>
                        <th>Đơn giá</th>
                        <th>Trạng thái</th>
                        <th style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center text-muted">@(i++)</td>
                            <td class="text-center">
                                <img src="@Url.Content("~/Images/" + item.HinhAnh)"
                                     class="rounded border shadow-sm"
                                     style="width: 60px; height: 60px; object-fit: cover;"
                                     alt="@item.TenSanPham"
                                     onerror="this.src='https://via.placeholder.com/60?text=No+Img'">
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenSanPham</div>
                                <small class="text-muted d-block text-truncate" style="max-width: 250px;">
                                    @item.MoTa
                                </small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@item.LoaiSanPham.TenLoai</span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @string.Format("{0:N0}", item.DonGia) đ
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == true)
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check"></i> Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fa-solid fa-ban"></i> Ngừng bán</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", new { id = item.MaSanPham })" class="btn btn-warning btn-sm" title="Sửa thông tin">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <button type="button" class="btn btn-danger btn-sm" title="Xóa sản phẩm"
                                            onclick="confirmDelete('@Url.Action("Delete", new { id = item.MaSanPham })', '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.TenSanPham))')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-warning text-center mt-3 shadow-sm">
        <i class="fa-solid fa-triangle-exclamation"></i> Chưa có sản phẩm nào trong hệ thống. Hãy bấm "Thêm sản phẩm mới".
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 bg-danger text-white">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Xác nhận xóa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="fa-solid fa-trash-can text-danger" style="font-size: 4rem;"></i>
                </div>
                <h5 class="fw-bold mb-2">Bạn có chắc muốn xóa sản phẩm này?</h5>
                <p class="text-primary fw-bold fs-5" id="productNameDelete"></p>
                <p class="text-muted small mb-0">Hành động này có thể sẽ không hoàn tác được.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light px-4 me-2" data-bs-dismiss="modal">Hủy bỏ</button>
                <a href="#" id="btnConfirmDelete" class="btn btn-danger px-4 fw-bold">
                    <i class="fa-solid fa-trash me-2"></i> Xóa ngay
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(deleteUrl, productName) {
            // 1. Gán tên sản phẩm vào modal cho rõ ràng
            document.getElementById('productNameDelete').innerText = productName;

            // 2. Gán đường dẫn xóa (Action Delete) vào nút "Xóa ngay"
            document.getElementById('btnConfirmDelete').setAttribute('href', deleteUrl);

            // 3. Hiển thị Modal (Bootstrap 5)
            var myModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            myModal.show();
        }
    </script>
}