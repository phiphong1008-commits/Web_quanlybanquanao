@model Project_65132692.Models.SanPham

@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3 class="mb-4 text-primary"><i class="fa-solid fa-plus-circle"></i> THÊM SẢN PHẨM MỚI</h3>

@using (Html.BeginForm("Create", "SanPhams_65132692", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white fw-bold">1. Thông tin chung</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên sản phẩm (*)</label>
                        @Html.EditorFor(model => model.TenSanPham, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Đơn giá (VNĐ) (*)</label>
                            @Html.EditorFor(model => model.DonGia, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", required = "required" } })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Loại sản phẩm (*)</label>
                            @Html.DropDownList("MaLoai", null, htmlAttributes: new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh đại diện</label>
                        <input type="file" name="HinhAnhUpload" class="form-control" accept="image/*" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control", rows = "4" })
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center">
                    <span>2. Quản lý Kho & Biến thể</span>
                    <button type="button" class="btn btn-sm btn-dark" onclick="addRow()">
                        <i class="fa-solid fa-plus"></i> Thêm dòng
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0 text-center" id="tblBienThe">
                        <thead class="bg-light">
                            <tr>
                                <th>Size</th>
                                <th>Màu sắc</th>
                                <th>Số lượng tồn</th>
                                <th>Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <select name="Size[]" class="form-select form-select-sm">
                                        <option value="S">S</option>
                                        <option value="M" selected>M</option>
                                        <option value="L">L</option>
                                        <option value="XL">XL</option>
                                        <option value="XXL">XXL</option>
                                        <option value="Free">FreeSize</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="text" name="MauSac[]" class="form-control form-control-sm" placeholder="VD: Đen, Trắng..." required />
                                </td>
                                <td>
                                    <input type="number" name="SoLuong[]" class="form-control form-control-sm" value="10" min="1" required />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    * Nhập ít nhất 1 dòng biến thể để khách hàng có thể mua.
                </div>
            </div>
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button type="submit" class="btn btn-success btn-lg">
            <i class="fa-solid fa-save"></i> LƯU SẢN PHẨM HOÀN TẤT
        </button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
}

<script>
    function addRow() {
        var table = document.getElementById("tblBienThe").getElementsByTagName('tbody')[0];
        var newRow = table.insertRow(table.rows.length);

        var cell1 = newRow.insertCell(0);
        var cell2 = newRow.insertCell(1);
        var cell3 = newRow.insertCell(2);
        var cell4 = newRow.insertCell(3);

        // Nội dung cột Size
        cell1.innerHTML = `
            <select name="Size[]" class="form-select form-select-sm">
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="Free">FreeSize</option>
            </select>`;

        // Nội dung cột Màu
        cell2.innerHTML = '<input type="text" name="MauSac[]" class="form-control form-control-sm" placeholder="Màu..." />';

        // Nội dung cột Số lượng
        cell3.innerHTML = '<input type="number" name="SoLuong[]" class="form-control form-control-sm" value="0" min="1" />';

        // Nút Xóa
        cell4.innerHTML = '<button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button>';
    }

    function removeRow(btn) {
        var row = btn.parentNode.parentNode;
        // Giữ lại ít nhất 1 dòng
        var table = document.getElementById("tblBienThe").getElementsByTagName('tbody')[0];
        if (table.rows.length > 1) {
            row.parentNode.removeChild(row);
        } else {
            alert("Phải có ít nhất 1 biến thể!");
        }
    }
</script>